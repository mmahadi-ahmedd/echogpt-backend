# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/echogpt?schema=public"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption (used to encrypt AI provider API keys at rest)
# Must be exactly 32 bytes, represented as 64 hex characters
ENCRYPTION_KEY="replace-with-a-32-byte-hex-string"

# Server
PORT=3000